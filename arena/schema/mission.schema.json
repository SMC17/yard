{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yard.dev/schema/arena/mission.v0.json",
  "title": "Yard Arena Mission v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "mission_id", "mission_version", "ruleset_id", "title",
    "summary", "currency_unit", "era", "route", "rng", "fleet_requirements",
    "design_bounds", "allowed_materials", "allowed_propulsion",
    "allowed_hull_forms", "objectives", "evaluation", "sources"
  ],
  "properties": {
    "schema_version": { "const": "yard.arena.mission.v0" },
    "mission_id": { "$ref": "#/$defs/nonempty" },
    "mission_version": { "$ref": "#/$defs/nonempty" },
    "ruleset_id": { "$ref": "#/$defs/nonempty" },
    "title": { "$ref": "#/$defs/nonempty" },
    "summary": { "$ref": "#/$defs/nonempty" },
    "currency_unit": { "$ref": "#/$defs/nonempty" },
    "era": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "start_year", "end_year", "mode"],
      "properties": {
        "label": { "$ref": "#/$defs/nonempty" },
        "start_year": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "end_year": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "mode": { "enum": ["historical_attested", "era_constrained_counterfactual"] }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "destination", "waypoints", "nominal_distance_nm"],
      "properties": {
        "origin": { "$ref": "#/$defs/nonempty" },
        "destination": { "$ref": "#/$defs/nonempty" },
        "waypoints": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "nominal_distance_nm": { "$ref": "#/$defs/nonnegative" }
      }
    },
    "rng": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "streams", "public_seeds", "hidden_seed_commitment_sha256"],
      "properties": {
        "algorithm": { "const": "blake3-counter-v1" },
        "streams": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["weather", "demand", "damage", "traffic", "sensor_noise"] }
        },
        "public_seeds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
        "hidden_seed_commitment_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fleet_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["min_vessels", "max_vessels", "min_nominal_cargo_t", "min_delivered_cargo_t", "max_budget_units", "max_loss_fraction", "max_crew_casualty_fraction"],
      "properties": {
        "min_vessels": { "type": "integer", "minimum": 0 },
        "max_vessels": { "type": "integer", "minimum": 1 },
        "min_nominal_cargo_t": { "$ref": "#/$defs/nonnegative" },
        "min_delivered_cargo_t": { "$ref": "#/$defs/nonnegative" },
        "max_budget_units": { "$ref": "#/$defs/nonnegative" },
        "max_mean_transit_days": { "type": ["number", "null"], "minimum": 0 },
        "max_loss_fraction": { "$ref": "#/$defs/fraction" },
        "max_crew_casualty_fraction": { "$ref": "#/$defs/fraction" }
      }
    },
    "design_bounds": {
      "type": "object", "additionalProperties": false,
      "required": [
        "min_length_m", "max_length_m", "min_beam_m", "max_beam_m",
        "min_draft_m", "max_draft_m", "min_displacement_t", "max_displacement_t",
        "min_block_coefficient", "max_block_coefficient", "min_length_beam_ratio",
        "max_length_beam_ratio", "min_beam_draft_ratio", "max_beam_draft_ratio",
        "min_crew_per_vessel", "max_crew_per_vessel", "max_displacement_error_fraction"
      ],
      "properties": {
        "min_length_m": { "$ref": "#/$defs/nonnegative" },
        "max_length_m": { "$ref": "#/$defs/nonnegative" },
        "min_beam_m": { "$ref": "#/$defs/nonnegative" },
        "max_beam_m": { "$ref": "#/$defs/nonnegative" },
        "min_draft_m": { "$ref": "#/$defs/nonnegative" },
        "max_draft_m": { "$ref": "#/$defs/nonnegative" },
        "min_displacement_t": { "$ref": "#/$defs/nonnegative" },
        "max_displacement_t": { "$ref": "#/$defs/nonnegative" },
        "min_block_coefficient": { "$ref": "#/$defs/fraction" },
        "max_block_coefficient": { "$ref": "#/$defs/fraction" },
        "min_length_beam_ratio": { "$ref": "#/$defs/nonnegative" },
        "max_length_beam_ratio": { "$ref": "#/$defs/nonnegative" },
        "min_beam_draft_ratio": { "$ref": "#/$defs/nonnegative" },
        "max_beam_draft_ratio": { "$ref": "#/$defs/nonnegative" },
        "min_crew_per_vessel": { "type": "integer", "minimum": 0 },
        "max_crew_per_vessel": { "type": "integer", "minimum": 0 },
        "max_displacement_error_fraction": { "$ref": "#/$defs/fraction" }
      }
    },
    "allowed_materials": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["oak", "teak", "softwood", "iron", "steel", "aluminum", "composite"] } },
    "allowed_propulsion": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sail", "sail_and_oar", "steam", "diesel", "hybrid", "electric", "nuclear"] } },
    "allowed_hull_forms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["monohull", "catamaran", "trimaran", "submersible"] } },
    "objectives": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "direction", "aggregate", "epsilon"],
        "properties": {
          "name": { "enum": ["delivered_cargo_t", "mean_transit_days", "p95_transit_days", "total_cost_units", "loss_fraction", "crew_casualty_fraction", "crew_exposure_days", "emissions_t_co2e", "required_freight_rate_units_per_t"] },
          "direction": { "enum": ["minimize", "maximize"] },
          "aggregate": { "enum": ["fixed", "mean", "median", "p95", "cvar90"] },
          "epsilon": { "$ref": "#/$defs/nonnegative" }
        }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["min_scenarios", "max_delivered_to_nominal_ratio", "ranking"],
      "properties": {
        "min_scenarios": { "type": "integer", "minimum": 1 },
        "max_delivered_to_nominal_ratio": { "$ref": "#/$defs/nonnegative" },
        "ranking": { "const": "epsilon_pareto_v1" }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "title", "url", "license", "note"],
        "properties": {
          "source_id": { "$ref": "#/$defs/nonempty" },
          "title": { "$ref": "#/$defs/nonempty" },
          "url": { "type": "string", "format": "uri" },
          "license": { "$ref": "#/$defs/nonempty" },
          "note": { "$ref": "#/$defs/nonempty" }
        }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "nonnegative": { "type": "number", "minimum": 0 },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
