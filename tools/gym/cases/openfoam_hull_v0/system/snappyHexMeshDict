/*--------------------------------*- C++ -*----------------------------------*\
| Hull STL snap — coarse L3 smoke (not production mesh quality)              |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;
keepPatches     true;

geometry
{
    hull.stl
    {
        type triSurfaceMesh;
        name hull;
    }
};

castellatedMeshControls
{
    maxLocalCells 80000;
    maxGlobalCells 80000;
    minRefinementCells 0;
    nCellsBetweenLevels 1;
    maxLoadUnbalance 0.10;
    resolveFeatureAngle 60;
    allowFreeStandingZoneFaces true;
    locationInMesh __LOCATION_IN_MESH__;
    features
    (
    );
    refinementSurfaces
    {
        hull
        {
            level (1 1);
            patchInfo { type wall; }
        }
    }
    refinementRegions {}
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 8;
    implicitFeatureSnap true;
    explicitFeatureSnap false;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    featureAngle 60;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags (layerSets layerFields);
mergeTolerance 1e-6;

// ************************************************************************* //
