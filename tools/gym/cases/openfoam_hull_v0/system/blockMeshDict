/*--------------------------------*- C++ -*----------------------------------*\
| Coarse box domain; prepare_case rewrites extents/cells from hull STL bbox  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Default 120 m hull-ish domain (overwritten by prepare_case).
vertices
(
    (__XMIN__ __YMIN__ __ZMIN__)
    (__XMAX__ __YMIN__ __ZMIN__)
    (__XMAX__ __YMAX__ __ZMIN__)
    (__XMIN__ __YMAX__ __ZMIN__)
    (__XMIN__ __YMIN__ __ZMAX__)
    (__XMAX__ __YMIN__ __ZMAX__)
    (__XMAX__ __YMAX__ __ZMAX__)
    (__XMIN__ __YMAX__ __ZMAX__)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (__NX__ __NY__ __NZ__) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    yMin
    {
        type patch;
        faces ((0 1 5 4));
    }
    yMax
    {
        type patch;
        faces ((3 7 6 2));
    }
    bottom
    {
        type wall;
        faces ((0 3 2 1));
    }
    top
    {
        type patch;
        faces ((4 5 6 7));
    }
);

// ************************************************************************* //
