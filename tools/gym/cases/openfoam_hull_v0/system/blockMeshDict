/*--------------------------------*- C++ -*----------------------------------*\
| Coarse box domain for smoke / pending snappyHexMesh around hull STL        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// Domain extents placeholder; prepare_case may rewrite for STL bbox.
vertices
(
    (-200 -80 -40)
    ( 400 -80 -40)
    ( 400  80 -40)
    (-200  80 -40)
    (-200 -80  40)
    ( 400 -80  40)
    ( 400  80  40)
    (-200  80  40)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (60 24 20) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5));
    }
    bottom
    {
        type wall;
        faces ((0 1 5 4));
    }
    top
    {
        type patch;
        faces ((3 7 6 2));
    }
    front
    {
        type symmetry;
        faces ((0 3 2 1));
    }
    back
    {
        type symmetry;
        faces ((4 5 6 7));
    }
);

