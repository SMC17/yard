FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (__UX__ 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (__UX__ 0 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    yMin
    {
        type            slip;
    }
    yMax
    {
        type            slip;
    }
    bottom
    {
        type            slip;
    }
    top
    {
        type            slip;
    }
    hull
    {
        type            noSlip;
    }
    ".*"
    {
        type            zeroGradient;
    }
}

