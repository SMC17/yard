#!/bin/sh
# Yard-Sea-v0 openfoam_hull_v0: snappyHexMesh + short simpleFoam forceCoeffs smoke.
# Prefer teacher-driven hybrid (native mesh + docker simpleFoam) when available.
# Debian OpenFOAM 1912: FOAM_ETC=/usr/share/openfoam/etc (libforces sha1 bug → use Docker 2412).
cd "${0%/*}" || exit 1
set -e

run_app() {
  name="$1"; shift
  echo "Running $name $*"
  "$name" "$@" > "log.$name" 2>&1 || {
    echo "$name failed; see log.$name"
    return 1
  }
}

run_app blockMesh
if [ -f constant/triSurface/hull.stl ]; then
  run_app snappyHexMesh -overwrite
fi
run_app checkMesh
potentialFoam -writep -writephi > log.potentialFoam 2>&1 || true
# ForceCoeffs: simpleFoam (needs turbulence model). May fail on Debian 1912 sha1.
if ! find postProcessing -name 'forceCoeffs.dat' -o -name 'coefficient.dat' 2>/dev/null | grep -q .; then
  sed -i 's/application[[:space:]]\+potentialFoam;/application     simpleFoam;/' system/controlDict || true
  simpleFoam > log.simpleFoam 2>&1 || true
fi
